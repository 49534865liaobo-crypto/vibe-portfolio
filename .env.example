# Google Analytics 4 Measurement ID.
# Example format: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# Optional Google Search Console HTML meta verification token.
# In Google Search Console, choose HTML tag verification and paste only the content value.
VITE_GSC_VERIFICATION_TOKEN=

# Cloudflare Analytics API reporting.
# Use a read-only API token. Do not commit .env.local.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ANALYTICS_API_TOKEN=
CLOUDFLARE_WEB_ANALYTICS_HOST=vibe-portfolio-dny.pages.dev
CLOUDFLARE_PAGES_SCRIPT_NAME=pages-worker--12907168-production
